{
  "name": "ninja-tales",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Original-content Ninja Tales RPG foundation",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "build": "node scripts/build.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  }
}
